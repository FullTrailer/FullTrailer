# FullTrailer's monad — runs the shared modules/monad/Typescript daemon
# (all.this checkout), pointed at this app's own namespace/kernel state via
# these env vars. Copy to .env (gitignored) and fill in SEED.

# Namespace authority key — 64 lowercase hex chars. Generate a fresh one for
# this app (do not reuse a personal/other monad's seed):
#   openssl rand -hex 32
SEED=

# Matches self.json's "identity" — the netget-facing namespace this monad
# claims. fulltrailer.<your-machine-hostname>, e.g. fulltrailer.suis-macbook-air.local
# (run `hostname` to find your machine's hostname).
ME_NAMESPACE=fulltrailer.CHANGE-ME.local

MONAD_NAME=fulltrailer
PORT=4100

# Aliases any of these Host headers to ME_NAMESPACE (see modules/monad's
# http/namespace.ts readLocalIdentityNamespace) — lets netget's mesh routes
# (local.netget/apps/fulltrailer, local.netget/monads/fulltrailer) resolve
# to the right namespace without a dedicated subdomain or /etc/hosts entry.
# Include your own machine hostname (`hostname`) alongside the two generic
# entries below.
MONAD_SELF_TAGS=local.netget,CHANGE-ME.local,127.0.0.1

# Absolute paths — the daemon process runs from its own checkout
# (all.this/modules/monad/Typescript), not from this directory, so these
# can't be relative. Substitute your actual apps/FullTrailer path.
ME_STATE_DIR=/absolute/path/to/apps/FullTrailer/monad/me-state
MONAD_SELF_CONFIG_PATH=/absolute/path/to/apps/FullTrailer/monad/self.json

# Default already targets http://127.0.0.1 — override only if netget's
# registration endpoint isn't reachable there.
# NETGET_LOCAL=http://local.netget
